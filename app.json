{
  "expo": {
    "name": "Portifolio Love",
    "slug": "Portifolio_love",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "velour",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita o acesso às fotos para adicionar imagens às memórias.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-video"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.joaolucas.portifoliolove",
      "adaptiveIcon": {
        "backgroundColor": "#4A0E17",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "64379252-a61a-4316-bfc8-8dfae1d2d84c"
      }
    },
    "owner": "joaolucas_goncalves"
  }
}
